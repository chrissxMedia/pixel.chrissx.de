---
import { BaseLayout, Footer } from "cmdesigns";
import type { ComponentProps } from "astro/types";
import favicon from "../favicon.png";
import Header from "../components/Header.astro";

export type Props = Pick<
    ComponentProps<typeof BaseLayout>,
    "type" | "article" | "noindex"
> & {
    title?: string;
    lang?: string;
};

let { title, lang = "en", ...seo } = Astro.props;
title = title ? `${title} | pixel` : "pixel aka. chrissx";
---

<BaseLayout {...seo} {favicon} {lang} {title} description="pixel's very cool website">
    <link rel="alternate" type="application/rss+xml" title="pixel's blog" href="/blog/rss.xml" slot="head" />
    <Header />
    <div class="content">
        <slot />
    </div>
    <Footer
        start={2021}
        rightsholder="Pixel Häußler, chrissx Media"
    />
</BaseLayout>

<style>
    :global(body) {
        font-family: var(--minecraft);
        max-width: 1000px;
        margin: 0 auto;
    }
    .content {
        margin: 0 0.5em;
    }
</style>
