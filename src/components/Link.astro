---
import { LinkCard } from "cmdesigns";
import type { HTMLAttributes } from "astro/types";

export type Props = HTMLAttributes<"a"> & {
    image?: string;
    subtitle?: string;
};

const { image, subtitle, ...attributes } = Astro.props;
---

<li>
    <LinkCard {...attributes} class="card">
        {image && <img src={image} alt="" width="48" height="48" loading="lazy" />}
        <span>
            <strong><slot /></strong>
            {subtitle && <small>{subtitle}</small>}
        </span>
    </LinkCard>
</li>

<style>
    li {
        list-style: none;
        display: flex;
        min-width: 0;
    }

    .card {
        flex: 1;
        min-height: 5rem;
    }

    .card > :global(.content) {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-family: var(--unifont);
    }

    .card:focus-visible {
        outline: 2px solid rgb(var(--transpink));
        outline-offset: 3px;
    }

    img {
        flex-shrink: 0;
        filter: invert(1);
    }

    span {
        min-width: 0;
    }

    small {
        display: block;
        color: #cccccc;
    }
</style>
