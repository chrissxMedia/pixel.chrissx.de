---
import type { CollectionEntry } from "astro:content";
import { LinkCard } from "cmdesigns";
import BlogTitle from "./BlogTitle.astro";

export type Props = CollectionEntry<"blog">;

const {
    data: { title, pub, lang },
    body,
    id,
} = Astro.props;

let preview = body
    ?.split(/\n\n+|  \n+/)
    .find((x) => x && !/^[#<>\-=_*¹-⁹]/.test(x))
    ?.split(/\s+/)
    .reduce((p, e) => (p.length > 250 ? p : p + " " + e));
preview = preview
    // TODO: there is probably a unicode class for this
    ?.replace(/[,;.?!]*$/, "…")
    .replaceAll(/\[(.+?)\]\(.+?\)/g, "$1")
    .replaceAll(/\*(.+?)\*|_(.+?)_/g, "$1");
---

<li {lang}>
    <LinkCard
        href={`/blog/${id}`}
        highlightBackground="linear-gradient(45deg, rgb(var(--transblue)), rgb(var(--transpink)))"
    >
        <BlogTitle {pub} {lang}><h3>{title}</h3></BlogTitle>
        <p>{preview}</p>
    </LinkCard>
</li>

<style>
    li {
        list-style: none;
        line-height: 1.4;
    }
    li > :global(.cm-link-card[data-frame] > .content) {
        padding: 1rem 1.3rem;
    }
    li :global(time) {
        white-space: nowrap;
    }
    h3 {
        margin: 0;
        font-size: 1.25em;
        transition: color 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }
    p {
        margin-top: 0.5rem;
        margin-bottom: 0;
        color: #cccccc;
        font-family: var(--sans-serif);
    }
    li:is(:hover, :focus-within) h3 {
        color: rgb(var(--transpink));
    }
</style>
