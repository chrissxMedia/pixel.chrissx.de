---
export type Props = {
    title: string;
};
---

<section>
    <h3>{Astro.props.title}</h3>
    <ul>
        <slot />
    </ul>
</section>

<style>
    h3 {
        margin-top: 0;
        margin-bottom: 0.75em;
        font-weight: normal;
    }

    ul {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
        gap: 1em;
        padding: 0;
        margin: 0;
    }
</style>
